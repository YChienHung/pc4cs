  number = {3},
  publisher = {Global Journals Inc. (USA)},
}

@article{publ14770163,
  abstract = {A number of Cellular Automata (CA)-based edge detectors have been developed recently due to the simplicity of the model and the potential for simultaneous removal of different types of noise in the process of detection. This paper introduced a novel edge detector using Outer Totalistic Cellular Automata. Its performance has been compared with other recently developed CA-based edge detectors, in addition to some classic methods, through testing images from a public library. Visual and quantitative measurement of similarity with manually marked correct edges confirmed the superiority of the proposed method over conventional and state-of-the-art CA-based edge detectors
},
  title = {An edge detection method using outer totalistic cellular automata},
  author = {Sebastian Amrogowicz and Yitian Zhao and Yifan Zhao},
