  volume = {38},
  year = {2015},
  doi = {10.1016/j.procir.2015.07.045},
  author = {Yifan Zhao and Jörn Mehnen and Wei Xu and Mosab Alrashed and Stephen Abineri and Rajkumar Roy},
  pages = {147--152},
  journal = {Procedia CIRP},
