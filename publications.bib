  year = {2018},
  doi = {10.1109/JAS.2017.7510745},
  publisher = {IEEE},
  number = {1},
  pages = {58--68},
  journal = {IEEE/CAA Journal of Automatica Sinica},
  accepted-date = {2017-09-29},
}

