@article{publ14948897,
	abstract = {This study has developed a novel saliency detection method based on compactness feature for detecting three common types of leakage in retinal fluorescein angiogram: large focal, punctate focal, and vessel segment leakage. Leakage from retinal vessels occurs in a wide range of retinal diseases, such as diabetic maculopathy and paediatric malarial retinopathy. The proposed framework consists of three major steps: saliency detection, saliency refinement and leakage detection. First, the Retinex theory is adapted to address the illumination inhomogeneity problem. Then two saliency cues, intensity and compactness, are proposed for the estimation of the saliency map of each individual superpixel at each level. The saliency maps at different levels over the same cues are fused using an averaging operator. Finally, the leaking sites can be detected by masking the vessel and optic disc regions. The effectiveness of this framework has been evaluated by applying it to different types of leakage images with cerebral malaria. The sensitivity in detecting large focal, punctate focal and vessel segment leakage is 98.1, 88.2 and 82.7 
},
	title = {A compactness based saliency approach for leakages detection in fluorescein angiogram},
	issue = {6},
	volume = {8},
	year = {2017},
	doi = {10.1007/s13042-016-0573-4},
	publisher = {Springer Verlag (Germany)},
	author = {Yitian Zhao and Pan Su and Jian Yang and Yifan Zhao and Yalin Zheng and Yongtian Wang},
	number = {6},
	pages = {1971–1979},
	journal = {International Journal of Machine Learning and Cybernetics},
	accepted-date = {2016-07-13}
}
