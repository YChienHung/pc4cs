@article{publ2195782,
 abstract = {The wavefront profile and the propagation velocity of waves in an experimentally observedBelousov-Zhabotinskii reaction are analyzed and a revised FitzHumgh-Nagumo (FHN) modelof these systems is identified. The ratio between the excitation period and the recovery period,for a solitary wave is studied, and included within the model. Averaged traveling velocities atdifferent spatial positions are shown to be consistent under the same experimental conditions.The relationship between the propagation velocity and the curvature of the wavefront are alsostudied to deduce the diffusion coefficient in the model, which is a function of the curvature ofthe wavefront and not a constant. The application of the identified model is demonstrated onreal experimental data and validated using multistep ahead predictions.},
 doi = {10.1142/S0218127411028556},
 issue = {2},
 note = {Paper published while author was at another institution. Not Cranfield research. Cannot submit to CERES 16.1.2015 JGH},
 pages = {505-512},
 publisher = {World Scientific Publishing},
 title = {Spatio-temporal modeling of wave formation in an excitable chemical medium based on a revised fitzhughnagumo model},
 url = {http://www.scopus.com/inward/record.url?partnerID=yv4JPVwI&eid=2-s2.0-79953844054&md5=cc60984e6be86dd9db997abc2c3293c5},
 volume = {21},
 year = {2011}
}
