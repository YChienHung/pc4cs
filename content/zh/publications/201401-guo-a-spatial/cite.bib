@article{publ4966585,
	abstract = {A nonlinear spatio-temporal system identi cation and analysis approach is used to study the dy-namical behaviour of the Belousov-Zhabotinsky (BZ) chemical reaction process. In our previousstudy ([Guo et al., 2010]), the dynamical behaviour of the BZ reaction in the spatial-temporaldomain has been analysed by identifying a coupled map lattice (CML) model of the process di-rectly from experimental data from a real BZ reaction experiment. In this paper, the frequencydomain analysis of the dynamics near equilibrium is carried out by mapping the obtained CMLmodel into higher order spatial frequency response functions to reveal the nonlinear couplingand modulation between the various initial spectral components in the process. As far as we areaware this is the rst study of any real spatio-temporal system using a spatio-temporal domainidenti cation and frequency domain analysis approach.},
	title = {A spatial frequency domain analysis of the Belousov-Zhabotinsky reaction},
	issue = {03},
	volume = {24},
	year = {2014},
	doi = {10.1142/S021812741450031X},
	publisher = {World Scientific Publishing},
	author = {Lingzhong Guo and Yuzhu Guo and Yifan Zhao and Stephen A. Billings and Daniel Coca and Zhiqiang Lang},
	number = {03},
	pages = {1450031},
	journal = {International Journal of Bifurcation and Chaos}
}
