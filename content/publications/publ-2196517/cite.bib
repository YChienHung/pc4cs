@article{publ2196517,
 abstract = {New methods of identifying the transition rule of a Belousov-Zhabotinskii (BZ) reaction directlyfrom experimental data using cellular automata (CA) models are investigated. The experimentalset-up and new techniques for image pre-processing to ensure the identification of representativemodels are discussed including noise reduction, pixel and color calibration. Two kinds of models,the Greenberg-Hasting model (GHM) and the polynomial CA model are studied in detail. It isshown that the results of identifying a real BZ reacting system are very encouraging and thepredicted patterns compare well with the imaged patterns both visually and quantitatively.},
 doi = {10.1142/S0218127407017999},
 issue = {5},
 note = {Paper published while author was at another institution. Not Cranfield research. Cannot submit to CERES 16.1.2015 JGH},
 pages = {1687-1702},
 publisher = {World Scientific Publishing},
 title = {Identification of the belousov-zhabotinskii reaction using cellular automata models},
 url = {http://www.scopus.com/inward/record.url?partnerID=yv4JPVwI&eid=2-s2.0-34547733391&md5=067cee6c75b61ab214f2e7253cbabdf8},
 volume = {17},
 year = {2007}
}
