@article{publ2194753,
 abstract = {This Letter introduces a method for identifying geometrical models of interface evolution, directly from experimental imaging data. These local growth models relate normal growth velocity to curvature and its derivatives estimated along the growing interface. Such models can reproduce many qualitative featuresof dendritic crystal growth as well as predict quantitatively its early stages of evolution. Numerical simulations and experimental crystal growth data are used to demonstrate the applicability of this approach},
 accepted-date = {2011-01-04},
 author = {Y. Zhao and D. Coca and S.A. Billings and R.I. Ristic and L.L. De Matos},
 doi = {10.1016/j.physleta.2011.01.012},
 issue = {7},
 journal = {Physics Letters A},
 note = {Publisher's version of the paper attached. Paper not published while author was at Cranfield. Cannot submit to CERES 31.10.2013 JJ},
 number = {7},
 pages = {1084--1091},
 publisher = {Elsevier},
 title = {Identification of geometrical models of interface evolution for dendritic crystal growth},
 url = {http://www.scopus.com/inward/record.url?partnerID=yv4JPVwI&eid=2-s2.0-79251610258&md5=9b896319b541bf6493a36d3b55092079},
 volume = {375},
 year = {2011}
}
