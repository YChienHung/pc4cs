@article{publ4438561,
 abstract = {A new NARX-based Granger linear and nonlinear casual influence detection method is presented inthis paper to address the potential for linear and nonlinear models in data with applications to humanEEG data analysis. Considering two signals initially, the paper introduces four indexes to measure thelinearity and nonlinearity of a single signal, and one signal influencing the second signal. This method isthen extended to the time-varying and multivariate cases. An adaptation of an Orthogonal Least Squaresroutine is employed to select the significant terms in the models. A numerical example is provided toillustrate the effectiveness of the new algorithms together with the application to real EEG data collectedfrom 4 patients.},
 accepted-date = {2012-09-19},
 author = {Yifan Zhao and Steve A. Billings and Hualiang Wei and Fei He and Ptolemaios G. Sarrigiannis},
 doi = {10.1016/j.jneumeth.2012.09.019},
 issue = {1},
 journal = {Journal of Neuroscience Methods},
 note = {Publisher's version of the paper attached. Paper not published while author was at Cranfield. Cannot submit to CERES 31.10.2013 JJ},
 number = {1},
 pages = {79--86},
 publisher = {Elsevier},
 title = {A new NARX-based Granger linear and nonlinear casual influence detection method with applications to EEG data},
 url = {http://www.scopus.com/inward/record.url?partnerID=yv4JPVwI&eid=2-s2.0-84867748196&md5=afb30907be5a77202c5ef14e928f6965},
 volume = {212},
 year = {2013}
}
