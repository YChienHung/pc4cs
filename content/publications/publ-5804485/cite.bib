@article{publ5804485,
 abstract = {Objective: To introduce a new method of quantitative EEG analysis in the time domain, the error reductionratio (ERR)-causality test. To compare performance against cross-correlation and coherence withphase measures.Methods: A simulation example was used as a gold standard to assess the performance of ERR-causality,against cross-correlation and coherence. The methods were then applied to real EEG data.Results: Analysis of both simulated and real EEG data demonstrates that ERR-causality successfullydetects dynamically evolving changes between two signals, with very high time resolution, dependenton the sampling rate of the data. Our method can properly detect both linear and non-linear effects,encountered during analysis of focal and generalised seizures.Conclusions: We introduce a new quantitative EEG method of analysis. It detects real time levels of synchronisationin the linear and non-linear domains. It computes directionality of information flow withcorresponding time lags.Significance: This novel dynamic real time EEG signal analysis unveils hidden neural network interactionswith a very high time resolution. These interactions cannot be adequately resolved by the traditionalmethods of coherence and cross-correlation, which provide limited results in the presence of non-lineareffects and lack fidelity for changes appearing over small periods of time.},
 accepted-date = {2013-06-15},
 author = {Ptolemaios G. Sarrigiannis and Yifan Zhao and Hua-Liang Wei and Stephen A. Billings and Jayne Fotheringham and Marios Hadjivassiliou},
 doi = {10.1016/j.clinph.2013.06.012},
 issue = {1},
 journal = {Clinical Neurophysiology},
 note = {**Online first ahead of print, waiting for publication details before validating** JJ 31.10.2013 - Paper not published while author was at Cranfield. Cannot submit to CERES},
 number = {1},
 pages = {32--46},
 publisher = {Elsevier},
 title = {Quantitative EEG analysis using error reduction ratio-causality test; validation on simulated and real EEG data},
 url = {http://www.scopus.com/inward/record.url?partnerID=yv4JPVwI&eid=2-s2.0-84879858536&md5=93235177e4cacd3e0066bd80733c5b73},
 volume = {125},
 year = {2014}
}
