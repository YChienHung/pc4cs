@article{publ3657697,
 abstract = {This paper introduces an error reduction ratio-causality (ERR-causality) test that can be used to detect andtrack causal relationships between two signals. In comparison to the traditional Granger method, one significantadvantage of the new ERR-causality test is that it can effectively detect the time-varying direction of linear ornonlinear causality between two signals without fitting a complete model. Another important advantage is thatthe ERR-causality test can detect both the direction of interactions and estimate the relative time shift betweenthe two signals. Numerical examples are provided to illustrate the effectiveness of the new method together withthe determination of the causality between electroencephalograph signals from different cortical sites for patientsduring an epileptic seizure.},
 author = {Yifan Zhao and Steve A. Billings and Hualiang Wei and Ptolemaios G. Sarrigiannis},
 doi = {10.1103/PhysRevE.86.051919},
 issue = {5},
 journal = {Physical Review E},
 note = {Publisher's version of the paper attached. Paper not published while author was at Cranfield. Cannot submit to CERES 31.10.2013 JJ},
 number = {5},
 pages = {051919},
 publisher = {American Physical Society},
 title = {Tracking time-varying causality and directionality of information flow using an error reduction ratio test with applications to electroencephalography data},
 url = {http://www.scopus.com/inward/record.url?partnerID=yv4JPVwI&eid=2-s2.0-84870666959&md5=ad2d6235f7ccbf4c8ab8136eee83e9ea},
 volume = {86},
 year = {2012}
}
