@article{publ2191372,
 abstract = {A simple scalar coupled map lattice (sCML) model for excitable media is derived in this paper. The new model, which has a simple structure, is shown to be closely related to the observed phenomena in excitable media. Properties of the sCML model are also investigated. Illustrative examples show that this kind of model is capable of reproducing the behavior of excitable media and of generating complex spatiotemporal patterns.},
 author = {YUZHU GUO and YIFAN ZHAO and DANIEL COCA and S. A. BILLINGS},
 doi = {10.1142/S0218127411030520},
 issue = {11},
 journal = {International Journal of Bifurcation and Chaos},
 note = {Publisher's version of the paper attached. Paper not published while author was at Cranfield. Cannot submit to CERES 31.10.2013 JJ},
 number = {11},
 pages = {3277--3292},
 publisher = {World Scientific Publishing},
 title = {A simple scalar coupled map lattice model for excitable media},
 url = {http://www.scopus.com/inward/record.url?partnerID=yv4JPVwI&eid=2-s2.0-84855249188&md5=a2aed50a2cb59d1c945812c86a9ae9cc},
 volume = {21},
 year = {2011}
}
