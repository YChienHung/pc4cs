{
  "name": "HugoBlox Codespace",
  "image": "docker.io/hugomods/hugo:debian-exts",
  // "updateContentCommand": "pnpm install --frozen-lockfile --prefer-offline",
  // "postCreateCommand": "pnpm --version && hugo version",
  "customizations": {
    "vscode": {
      "extensions": [
        "ownable.ownable"
      ]
    }
  },
  "mounts": [
    "source=pnpm-store,target=/home/hugo/.local/share/pnpm,type=volume"
  ],
  "remoteUser": "hugo",
  "containerUser": "hugo",
  "updateRemoteUserUID": false,
  "forwardPorts": [
    1313
  ],
  "portsAttributes": {
    "1313": {
      "label": "Hugo Server"
    }
  }
}
